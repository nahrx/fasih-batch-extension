{
  "manifest_version": 3,
  "name": "FASIH Batch",
  "version": "2.3.0",
  "description": "Panel sheet untuk update massal assignment FASIH. Kolom dan proses diambil dari file batch-automation.js yang di-import.",
  "permissions": [
    "userScripts"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Buka/tutup panel FASIH Batch"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fasih-sm.bps.go.id/*"
      ],
      "js": [
        "lib/general_console.js",
        "sheet.js",
        "panel.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fasih-sm.bps.go.id/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "templates/batch-automation.template.js"
      ],
      "matches": [
        "https://fasih-sm.bps.go.id/*"
      ]
    }
  ]
}
